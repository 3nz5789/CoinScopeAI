# ============================================================
#  CoinScopeAI — Environment Configuration Template
#  Copy this file to .env and fill in your actual values.
#  NEVER commit .env to version control.
# ============================================================


# ── Engine Mode ──────────────────────────────────────────────
# Set to "true" to run against the Binance Futures Testnet.
# Set to "false" ONLY when you are ready for live mainnet trading.
TESTNET_MODE=true

# Base URL of the CoinScopeAI FastAPI engine.
# Change port if you run uvicorn on a different port.
COINSCOPEAI_BASE_URL=http://localhost:8001


# ── Binance Futures Testnet Credentials ──────────────────────
# Generate keys at: https://testnet.binancefuture.com
# These keys only work against the testnet — they have NO mainnet access.
BINANCE_FUTURES_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_FUTURES_TESTNET_API_SECRET=your_testnet_api_secret_here

# Binance Mainnet credentials (leave blank until ready for live trading).
# Generate keys at: https://www.binance.com/en/my/settings/api-management
BINANCE_FUTURES_MAINNET_API_KEY=
BINANCE_FUTURES_MAINNET_API_SECRET=


# ── Risk Management Parameters ────────────────────────────────
# Maximum allowed loss as a percentage of account equity in a single day.
# Engine will halt trading for the rest of the day if this is breached.
# Example: 2.0 = stop trading after losing 2% of account in one day.
MAX_DAILY_LOSS_PCT=2.0

# Number of consecutive losing trades before the engine pauses.
# Gives the system a cooling-off period to reassess market conditions.
# Recommended range: 3–5
MAX_CONSECUTIVE_LOSSES=3

# Maximum peak-to-trough drawdown (%) before all trading is suspended.
# Example: 10.0 = halt if account drops 10% from its all-time high.
MAX_DRAWDOWN_PCT=10.0

# Maximum number of simultaneous open positions across all pairs.
# Keeps total portfolio risk manageable.
# Canonical max open positions: 5 (revised 2026-05-03 — supersedes earlier 3-cap)
MAX_OPEN_POSITIONS=5

# Initial account capital in USD. Used by the trade journal for
# equity curve calculations and Kelly position sizing baseline.
INITIAL_CAPITAL=10000.0


# ── Signal & Scoring Thresholds ───────────────────────────────
# Minimum confluence score (out of 10) required to fire a LONG or SHORT signal.
# Higher = fewer but higher-quality signals.
# Recommended: 7.0–8.5 for conservative operation.
MIN_CONFLUENCE_SCORE=7.5

# Minimum HMM regime confidence (0.0–1.0) required to act on a signal.
# Signals in low-confidence regimes are suppressed.
MIN_REGIME_CONFIDENCE=0.55


# ── Market Scanner Configuration ─────────────────────────────
# Comma-separated list of trading pairs to scan.
# Use Binance Futures format (e.g. BTC/USDT not BTCUSDT).
SCAN_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT,DOGE/USDT,AVAX/USDT,LINK/USDT

# How often (in seconds) to run a full market scan.
# 14400 = every 4 hours (aligned with the 4h trading timeframe).
# Minimum recommended: 3600 (1 hour) to respect Binance rate limits.
SCAN_INTERVAL_SECONDS=14400

# Primary OHLCV timeframe used by the scanner and HMM regime detector.
SCAN_TIMEFRAME=4h

# Number of OHLCV bars to fetch per pair per scan.
# 300 bars at 4h = ~50 days of history (sufficient for HMM fitting).
OHLCV_LIMIT=300


# ── Telegram Alerts ───────────────────────────────────────────
# Bot token from @BotFather on Telegram.
# Used to send signal alerts, daily summaries, and critical errors.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your personal Telegram chat ID (or a group/channel chat ID).
# Obtain yours by messaging @userinfobot on Telegram.
TELEGRAM_CHAT_ID=your_chat_id_here

# Alert verbosity level: "all" | "signals_only" | "critical_only"
TELEGRAM_ALERT_LEVEL=signals_only


# ── Notion Integration ────────────────────────────────────────
# Notion integration token from: https://www.notion.so/my-integrations
NOTION_TOKEN=your_notion_integration_token_here

# ID of the Notion Trade Journal database.
# Found in the database URL: notion.so/workspace/<DATABASE_ID>?v=...
NOTION_TRADE_JOURNAL_DB_ID=28e29aaf-938e-81eb-8c91-d166a2246520

# ID of the Notion Performance Dashboard page (optional).
NOTION_DASHBOARD_PAGE_ID=


# ── Database (SQLite default / PostgreSQL optional) ───────────
# For local development use SQLite (no setup required).
# For production use PostgreSQL: postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///coinscope_trades.db


# ── Redis (optional — used for caching and rate-limit state) ──
# Only required if you enable the Redis-backed regime cache or
# the real-time dashboard WebSocket broadcaster.
# Leave as defaults if running locally without Redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your_redis_password_here   # uncomment if Redis auth is enabled


# ── Whale Alert Integration ───────────────────────────────────
# API key from https://whale-alert.io for large on-chain transaction data.
# Leave blank to disable whale filtering (MockWhaleFilter will be used).
WHALE_ALERT_KEY=


# ── Alpha Decay Monitor ───────────────────────────────────────
# Minimum Sharpe ratio (annualised) below which the decay monitor
# triggers an alert recommending a strategy review.
ALPHA_DECAY_MIN_SHARPE=0.8

# Rolling window (in days) for alpha decay calculations.
ALPHA_DECAY_WINDOW_DAYS=30


# ── Scale-Up Manager ──────────────────────────────────────────
# Minimum number of completed trades before a scale-up is considered.
SCALE_UP_MIN_TRADES=20

# Minimum Sharpe ratio required to qualify for the next scale profile.
SCALE_UP_MIN_SHARPE=1.2

# Path to persist the current scaling profile across restarts.
SCALE_UP_STATE_FILE=scale_up_state.json


# ── Logging & Monitoring ──────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Directory where engine log files are written.
LOG_DIR=logs

# Enable Prometheus metrics endpoint at /metrics (true/false).
# Requires: pip install prometheus-client
METRICS_ENABLED=false
METRICS_PORT=9090


# ── Walk-Forward Validation ───────────────────────────────────
# Number of folds used in walk-forward validation (/validate endpoint).
WFV_N_FOLDS=3

# Ratio of each fold used for training vs. out-of-sample testing.
WFV_TRAIN_RATIO=0.70

# Minimum out-of-sample Sharpe required for a fold to "pass".
WFV_MIN_SHARPE=0.8


# ── WebSocket Configuration (Binance April 2026 update) ───────
# New base paths as per Binance WebSocket migration (effective 2026-04-23).
# Public market streams
BINANCE_WS_PUBLIC_PATH=/public
# Market data streams
BINANCE_WS_MARKET_PATH=/market
# Private user data streams
BINANCE_WS_PRIVATE_PATH=/private

# Testnet WebSocket base URL
BINANCE_WS_TESTNET_URL=wss://stream.binancefuture.com
# Mainnet WebSocket base URL
BINANCE_WS_MAINNET_URL=wss://fstream.binance.com


# ── Stripe Billing (TEST MODE) ────────────────────────────────
# Keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_51TKFFiLMbmZv4VFt...
STRIPE_PUBLISHABLE_KEY=pk_test_51TKFFiLMbmZv4VFt...

# Webhook signing secret from: stripe listen --forward-to localhost:8002/billing/webhook
# OR from Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Stripe Price IDs (create these in Stripe Dashboard → Products) ──────────
# Create 4 products (Free, Trader, Desk Preview, Desk Full) each with 2 prices:
#   monthly recurring + annual recurring (20% off).
# Copy the price_xxx IDs here.

STRIPE_PRICE_FREE_MONTHLY=price_...
STRIPE_PRICE_FREE_ANNUAL=price_...

STRIPE_PRICE_TRADER_MONTHLY=price_...
STRIPE_PRICE_TRADER_ANNUAL=price_...

STRIPE_PRICE_DESK_PREVIEW_MONTHLY=price_...
STRIPE_PRICE_DESK_PREVIEW_ANNUAL=price_...

STRIPE_PRICE_DESK_FULL_MONTHLY=price_...
STRIPE_PRICE_DESK_FULL_ANNUAL=price_...

# ── Billing Redirect URLs ──────────────────────────────────────
# Where Stripe redirects after checkout completes / is cancelled.
# {CHECKOUT_SESSION_ID} is replaced by Stripe automatically.
BILLING_SUCCESS_URL=http://localhost:8080/billing_success.html?session_id={CHECKOUT_SESSION_ID}
BILLING_CANCEL_URL=http://localhost:8080/pricing.html

# Where Stripe redirects after the customer exits the billing portal.
# Typically your account/settings page. Override per-session via the API.
BILLING_PORTAL_RETURN_URL=http://localhost:8080/account.html
