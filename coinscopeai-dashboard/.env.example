# ──────────────────────────────────────────────────────────────────────────────
# CoinScopeAI Dashboard — Environment Variables
# Copy to .env and fill in values. Never commit .env.
# ──────────────────────────────────────────────────────────────────────────────

# Manus OAuth portal base URL — validation-cohort gate
# e.g. https://oauth.manus.computer
VITE_OAUTH_PORTAL_URL=

# Manus App ID issued for this deployment
VITE_APP_ID=

# Secret used for signing/verifying session tokens (min 32 chars)
SESSION_SECRET=

# Engine API URL (override for prod)
# Default (local dev): http://localhost:8001
VITE_ENGINE_URL=http://localhost:8001

# Node environment
NODE_ENV=development
